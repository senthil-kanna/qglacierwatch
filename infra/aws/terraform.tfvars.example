# Copy to terraform.tfvars (git-ignored). scripts/aws/*.ps1 maintain the values below.
alert_email       = "you@example.com"
create_compute    = false # bootstrap: false; deploy.ps1 sets true once images exist
api_image_tag     = ""    # git SHA built by the aws-deploy workflow
app_image_tag     = ""
dashboard_enabled = true
schedules_enabled = true
