# Copy to .env for local overrides. Never commit real values; .env is git-ignored.

# --- Application (local runs and containers) ---------------------------------------------------
QGW_MODE=demo                    # demo (SYNTHETIC fixture) | real (data/raw from Earth Engine + GloFAS)
EE_PROJECT=ee-your-project       # Google Earth Engine cloud project (noncommercial registration)
# EE_SERVICE_ACCOUNT_JSON=       # containers only; in Azure this comes from Key Vault (ee-service-account-json)
QGW_API_KEY=                     # set to require X-API-Key on /v1 data routes; in Azure: Key Vault qgw-api-key
QGW_RATE_PER_MIN=60
# QGW_DATA=/mnt/qgw/data         # storage roots; in Container Apps these point at the Azure Files mount
# QGW_ARTIFACTS=/mnt/qgw/artifacts
# QGW_REPORTS=/mnt/qgw/reports

# --- Azure deployment (scripts/azure/*.ps1 parameters; identifiers only, no secrets) ------------
# AZURE_SUBSCRIPTION_ID=         # from `az account show --query id -o tsv` after approval
# AZURE_LOCATION=centralindia    # must be allowed by the student subscription policy (preflight checks)
# AZURE_RESOURCE_GROUP=rg-qglacierwatch
# ALERT_EMAIL=you@example.com    # budget and metric-alert e-mails
# QGW_IMAGE=ghcr.io/senthil-kanna/qglacierwatch   # public GHCR package; tag = git SHA from the `image` workflow
# Secrets live only in Azure Key Vault (set by deploy.ps1) and GitHub (GITHUB_TOKEN, automatic).
# GitHub OIDC for the cd workflow uses repository VARIABLES (not secrets): AZURE_CLIENT_ID,
# AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID, AZURE_RESOURCE_GROUP, ALERT_EMAIL.
