# Copy to .env for local overrides. Never commit real values.
QGW_MODE=demo                    # demo (SYNTHETIC fixture) | real (data/raw from Earth Engine + GloFAS)
EE_PROJECT=ee-your-project       # Google Earth Engine cloud project (noncommercial registration)
# EE_SERVICE_ACCOUNT_JSON=       # containers only; in Azure this comes from Key Vault
QGW_API_KEY=                     # set to require X-API-Key on /v1 data routes
QGW_RATE_PER_MIN=60
# QGW_DATA=/mnt/qgw/data         # override storage roots (Azure Files mount in Container Apps)
# QGW_ARTIFACTS=/mnt/qgw/artifacts
# QGW_REPORTS=/mnt/qgw/reports
